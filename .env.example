# MongoDB Database Connection
# Local Docker / MongoDB: mongodb://localhost:27017/musicas-missa
# MongoDB Atlas Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/musicas-missa
MONGO_URI=mongodb://localhost:27017/musicas-missa

# Backend Port
PORT=3333

# Frontend API URL consumed by React (Vite)
VITE_API_URL=http://localhost:3333

# JWT Secret Key
JWT_SECRET=musicas-missa-super-secret-jwt-key-change-in-production

# Initial Admin Bootstrap Credentials (Criado automaticamente se o banco estiver sem admin)
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Administrador
